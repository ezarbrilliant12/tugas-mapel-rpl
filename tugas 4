<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Form Pendaftaran Siswa Baru</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 600px;
            margin: 30px auto;
            padding: 0 20px;
        }

        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        button {
            margin-top: 20px;
            padding: 10px 25px;
            background: #2E6DB4;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        button:hover {
            background: #1A3C6E;
        }

        .group-radio {
            display: flex;
            gap: 20px;
            margin-top: 5px;
        }

        .group-radio label {
            font-weight: normal;
            margin-top: 0;
        }

        .group-checkbox label {
            font-weight: normal;
            margin-top: 8px;
        }
    </style>
</head>

<body>

    <h1>Form Pendaftaran Siswa Baru</h1>

    <p>SMK Telkom Malang Tahun Pelajaran 2026/2027</p>

    <hr>

    <form action="" method="POST">

        <!-- IDENTITAS DIRI -->
        <h2>A. Identitas Diri</h2>

        <label for="namalengkap">Nama Lengkap: *</label>
        <input
            type="text"
            id="namalengkap"
            name="namalengkap"
            placeholder="Tulis nama lengkap sesuai akta"
            required
            minlength="3"
            maxlength="100"
        >

        <label for="nisn">NISN: *</label>
        <input
            type="text"
            id="nisn"
            name="nisn"
            placeholder="10 digit NISN"
            required
            pattern="[0-9]{10}"
            title="NISN harus terdiri dari 10 digit angka"
        >

        <label>Jenis Kelamin: *</label>

        <div class="group-radio">
            <label>
                <input type="radio" name="jenis_kelamin" value="L" required>
                Laki-laki
            </label>

            <label>
                <input type="radio" name="jenis_kelamin" value="P">
                Perempuan
            </label>
        </div>

        <label for="tgl_lahir">Tanggal Lahir: *</label>
        <input
            type="date"
            id="tgl_lahir"
            name="tgl_lahir"
            required
        >

        <label for="tempat_lahir">Tempat Lahir: *</label>
        <input
            type="text"
            id="tempat_lahir"
            name="tempat_lahir"
            placeholder="Kota kelahiran"
            required
        >

        <!-- KONTAK -->
        <h2>B. Informasi Kontak</h2>

        <label for="email">Email Aktif: *</label>
        <input
            type="email"
            id="email"
            name="email"
            placeholder="email@contoh.com"
            required
        >

        <label for="no_hp">No. HP / WhatsApp: *</label>
        <input
            type="tel"
            id="no_hp"
            name="no_hp"
            placeholder="08xxxxxxxxxx"
            required
        >

        <label for="alamat">Alamat Lengkap: *</label>
        <textarea
            id="alamat"
            name="alamat"
            rows="3"
            placeholder="Jalan, RT/RW, Desa/Kelurahan, Kecamatan, Kota"
            required
        ></textarea>

        <!-- PILIHAN JURUSAN -->
        <h2>C. Pilihan Program Keahlian</h2>

        <label for="jurusan">Pilihan Jurusan: *</label>

        <select id="jurusan" name="jurusan" required>
            <option value="">-- Pilih Jurusan --</option>
            <option value="rpl">Rekayasa Perangkat Lunak (RPL)</option>
            <option value="tkj">Teknik Komputer & Jaringan (TKJ)</option>
            <option value="mm">Multimedia (MM)</option>
            <option value="akl">Akuntansi Keuangan Lembaga (AKL)</option>
        </select>

        <label>Hobi / Minat: (Boleh pilih lebih dari satu)</label>

        <div class="group-checkbox">

            <label>
                <input type="checkbox" name="hobi[]" value="coding">
                Coding
            </label>

            <label>
                <input type="checkbox" name="hobi[]" value="desain">
                Desain Grafis
            </label>

            <label>
                <input type="checkbox" name="hobi[]" value="olahraga">
                Olahraga
            </label>

            <label>
                <input type="checkbox" name="hobi[]" value="gaming">
                Gaming
            </label>

            <label>
                <input type="checkbox" name="hobi[]" value="musik">
                Musik
            </label>

        </div>

        <button type="submit">Daftar</button>
        <button type="reset">Reset</button>

    </form>

</body>

</html>